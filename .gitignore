# KiCad auto-generated — never commit
hardware/kicad/*-backups/
hardware/kicad/*.000
hardware/kicad/*.bak
hardware/kicad/*_autosave.*
hardware/kicad/fp-info-cache
hardware/kicad/_autosave-*
hardware/kicad/*.lock
**/.history/

# keep reference manuals, datasheets and service manuals locally, but don't
# commit them. Only the link index is tracked.
hardware/datasheets/*
!hardware/datasheets/DATASHEET_LINKS.md

# OS
.DS_Store
Thumbs.db
desktop.ini

# Python scripts (if any)
__pycache__/
*.pyc
