# DSR-1 WM-D6C Servo Replacement — Renode simulation script
#
# Run from the workspace root (d:/Projects/wmd6c-servo):
#   renode firmware/simulation/scripts/dsr1.resc
#
# Override the ELF path on the command line if needed:
#   renode -e "$bin=@path/to/custom.elf" firmware/simulation/scripts/dsr1.resc
#
# After the simulation starts, use the Renode monitor (console) or source
# the FG generator helper to drive the servo loop:
#   (monitor) i @firmware/simulation/scripts/fg-gen.resc

$bin?=@firmware/build/firmware.elf
$name?="DSR-1"

mach create $name
machine LoadPlatformDescription @firmware/simulation/platform/stm32g0b1kbu6.repl

# ADC pot inputs (RV601/PA1, RV602/PA2, RV603/PA3) are not set here.
# The trim path (adc_get_adjusted_target) has no caller in the current firmware
# (findings §3.3) so ADC values do not affect the servo loop.
# Restore when the trim path is wired: sysbus.adc SetVoltage <ch> <voltage>

# Open GDB server on port 3333 so VS Code (launch.json) can attach.
machine StartGdbServer 3333

macro reset
"""
    sysbus LoadELF $bin
"""

runMacro $reset
