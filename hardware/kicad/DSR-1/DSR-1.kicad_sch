		(uuid "078ec35b-8647-4679-b7c4-bd5e8a02d0c5")
	)
	(text "RV602"
		(exclude_from_sim no)
		(at 235.458 331.724 0)
		(effects
			(font
				(size 1.905 1.905)
				(thickness 0.381)
				(bold yes)
			)
			(justify left)
		)
		(uuid "15500b4b-17e3-416b-b0e5-932cd90c303a")
	)
	(text "VERIFY WIPER VOLTAGES ON BENCH BEFORE POWER-ON.\nIf any wiper exceeds 3.3V at B+1 = 6V, add resistor\ndivider on Sheet 5 before the clamp diodes.\nSee signal-chain-analysis.md §4."
		(exclude_from_sim no)
		(at 176.784 87.122 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "1726f9fb-3c03-4a09-9076-5fbe11379ff3")
	)
	(text "FG Signal Path\n(J1 Pin 1 → PA0)"
		(exclude_from_sim no)
		(at 124.714 178.562 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "24f87f5e-3323-46ad-95c7-41eb66514ab6")
	)
	(text "R5 holds BOOT0 low at reset → normal boot from flash.\nTo enter system bootloader: pull PA14 high before reset\nvia SWD header. Do not remove R5 - floating BOOT0\ncauses unpredictable boot behavior."
		(exclude_from_sim no)
		(at 176.53 128.27 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4193af99-dc3c-4a8c-befd-17a55976044d")
	)
	(text "VERIFY WIPER VOLTAGE BEFORE POWER-ON. See signal-chain- analysis.md §4 for divider formula. \nIf wiper exceeds 3.3V, add R/2R divider before the 100Ω series resistor. Adjust ADC scaling in firmware to match."
		(exclude_from_sim no)
		(at 213.868 359.664 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4a7a189c-51c9-4898-9403-f9aac7fcb2bb")
	)
	(text "ADC Inputs - RV601, RV602, RV603 (J1 Pins 4, 5, 6 → PA1, PA2, PA3)"
		(exclude_from_sim no)
		(at 264.922 291.592 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "55b3d4f6-439d-4192-9c21-782d79e2dc5b")
	)
	(text "VERIFY ACTUAL FG SWING ON BENCH BEFORE POWER-ON. \nR4 value may need adjustment based on measured B+1 and pull-up resistor. \nSee signal-chain-analysis.md §1 for formula. \nDo not connect FG directly to PA0 without confirming the conditioned voltage\nis below 3.3V."
		(exclude_from_sim no)
		(at 86.614 257.302 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "7ba1d9b5-6fe8-4cdd-b78d-b11fa9eeb4d8")
	)
	(text "Motor Enable Monitor\n(J1 Pin 3 → PA5)"
		(exclude_from_sim no)
		(at 308.864 179.324 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "a1027ec4-853c-4c08-9917-acb225c92b4a")
	)
	(text "C11 (C0G) must be placed closest to pin 4 on PCB.\nC0G for ADC noise - do not substitute X5R here.\nEP (pin 33): via array 2×2 or 3×3 grid, 0.3mm drill."
		(exclude_from_sim no)
		(at 164.592 52.832 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ac4bccb4-a1ee-447e-9004-7f4b11d2a090")
	)
	(text "Motor Drive Output\n(PA6 → J1 Pin 2 → Q601 base)"
		(exclude_from_sim no)
		(at 225.552 180.086 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "b554559a-aba7-416d-b311-86fca30c22a0")
	)
	(text "Q601 (2SB1013 PNP) is on WM-D6C main board - NOT on DSR-1 PCB.\nQ601 emitter → B+3 via Q703/Q704 mode-switch chain. \nQ601 base operating range must be measured on bench to confirm R9\nsizing. See signal-chain-analysis.md §2.\n\n"
		(exclude_from_sim no)
		(at 188.976 257.302 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c37e9ad1-8f74-4033-aa71-2bd72298e6a0")
	)
	(text "CC1 (PA8) and CC2 (PA9) connect to both IP2721 (PD\nnegotiation) and STM32 UCPD1 (monitoring/control).\nFirmware must clear SYSCFG_CFGR1 UCPD_STROBE early\nin startup - see RM0444 §28 for UCPD init sequence."
		(exclude_from_sim no)
		(at 177.038 104.394 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c8471e0c-538f-4ccb-aaf5-71ce15411166")
	)
	(text "PA9/PA10 can remap to PA11/PA12 pins\nvia SYSCFG_CFGR1. Do not remap while USB is active.\nPCB: route as 90Ω differential pair, matched length,\n≤25mm, away from MT3608 SW node."
		(exclude_from_sim no)
		(at 176.784 113.792 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "db66463c-1029-42ca-a281-36431417423d")
	)
	(text "MOTOR_EN tap point: IC601 footprint pin 7 pad on \nWM-D6C main board. Verify voltage on bench before\nconnecting. See signal-chain-analysis.md §3."
		(exclude_from_sim no)
		(at 285.242 253.492 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f8c8cb68-f1ed-4fd5-9632-829ecedc57cb")
	)
