			)
		)
		(uuid "99a15a53-8174-4aa2-acf0-76a0ce843ed3")
	)
	(text "16v\n"
		(exclude_from_sim no)
		(at 87.376 189.992 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "9bb9b990-d0ad-4de1-92dd-4dcc72e13f3e")
	)
	(text "Motor Enable Monitor\n(J1 Pin 3 → PA5)"
		(exclude_from_sim no)
		(at 645.414 188.214 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "a1027ec4-853c-4c08-9917-acb225c92b4a")
	)
	(text "B+1 output = 0.8 × (1 + 649k/100k) = 6.19V\nEN tied to VIN - AP63203 internal clamp handles 9V input safely.\nC3 (BST cap) must be placed within 1mm of BST/SW pins on PCB."
		(exclude_from_sim no)
		(at 98.044 154.432 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ab76580d-eb55-4506-9491-76029249dea7")
	)
	(text "C11 (C0G) must be placed closest to pin 4 on PCB.\nC0G for ADC noise - do not substitute X5R here.\nEP (pin 33): via array 2×2 or 3×3 grid, 0.3mm drill."
		(exclude_from_sim no)
		(at 501.142 61.722 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ac4bccb4-a1ee-447e-9004-7f4b11d2a090")
	)
	(text "Motor Drive Output\n(PA6 → J1 Pin 2 → Q601 base)"
		(exclude_from_sim no)
		(at 562.102 188.976 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "b554559a-aba7-416d-b311-86fca30c22a0")
	)
	(text "Q601 (2SB1013 PNP) is on WM-D6C main board - NOT on DSR-1 PCB.\nQ601 emitter → B+3 via Q703/Q704 mode-switch chain. \nQ601 base operating range must be measured on bench to confirm R9\nsizing. See signal-chain-analysis.md §2.\n\n"
		(exclude_from_sim no)
		(at 525.526 266.192 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c37e9ad1-8f74-4033-aa71-2bd72298e6a0")
	)
	(text "CC1 (PA8) and CC2 (PA9) connect to both IP2721 (PD\nnegotiation) and STM32 UCPD1 (monitoring/control).\nFirmware must clear SYSCFG_CFGR1 UCPD_STROBE early\nin startup - see RM0444 §28 for UCPD init sequence."
		(exclude_from_sim no)
		(at 513.588 113.284 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "c8471e0c-538f-4ccb-aaf5-71ce15411166")
	)
	(text "B+3 output = 0.6 × (1 + 169k/10k) = 10.74V nominal.\n⚠ SW NODE: high dV/dt at 1.2MHz. Keep SW trace <3mm.\nMinimum 2mm clearance to FG, ADC, and motor drive signal traces.\nC8 must be 47µF (not 22µF) - X5R derating at 10.8V reduces\neffective capacitance. Use 16V rated part for adequate margin."
		(exclude_from_sim no)
		(at 91.694 239.522 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "d1826de7-495f-49f9-ae23-cc0aa9aeb170")
	)
	(text "PA9/PA10 can remap to PA11/PA12 pins\nvia SYSCFG_CFGR1. Do not remap while USB is active.\nPCB: route as 90Ω differential pair, matched length,\n≤25mm, away from MT3608 SW node."
		(exclude_from_sim no)
		(at 513.334 122.682 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "db66463c-1029-42ca-a281-36431417423d")
	)
	(text "16v\n"
		(exclude_from_sim no)
		(at 165.862 94.996 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "efb1be02-a765-4977-ab62-9b99b317bd32")
	)
	(text "Fixed 3.3V LDO. VIN max 16V - B+1 = 6V nominal, margin adequate.\nRequires minimum 1µF on VOUT for stability - C7+C10 exceed this."
		(exclude_from_sim no)
		(at 226.314 255.524 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "efefe084-06e7-456a-8e90-3e99f0426058")
	)
	(text "MOTOR_EN tap point: IC601 footprint pin 7 pad on \nWM-D6C main board. Verify voltage on bench before\nconnecting. See signal-chain-analysis.md §3."
		(exclude_from_sim no)
		(at 621.792 262.382 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f8c8cb68-f1ed-4fd5-9632-829ecedc57cb")
	)
