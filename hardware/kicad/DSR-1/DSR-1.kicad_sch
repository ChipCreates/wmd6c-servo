	)
	(text "VERIFY WIPER VOLTAGE BEFORE POWER-ON. See signal-chain- analysis.md §4 for divider formula. \nIf wiper exceeds 3.3V, add R/2R divider before the 100Ω series resistor. Adjust ADC scaling in firmware to match."
		(exclude_from_sim no)
		(at 550.418 368.554 0)
