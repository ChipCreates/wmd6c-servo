	(text "Variant B - Barrel Jack, Polarity Agnostic\n\n"
		(exclude_from_sim no)
		(at 73.66 178.562 0)
		(effects
			(font
				(size 2.54 2.54)
				(thickness 0.508)
				(bold yes)
			)
		)
		(uuid "05dd8093-6cb9-4e01-977b-f72bfb973be0")
	)
	(text "BRING-UP ORDER:\n1. Verify 9V_PD present before AP63203 powers up\n2. Check B+1 = 6.0-6.2V before enabling downstream\n3. Check B+3 = 10.5-11V (no load)\n4. Check +3.3V = 3.3V ±2%\n5. Do not connect WM-D6C harness until all rails verified"
		(exclude_from_sim no)
		(at 30.226 344.678 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "0626b283-a5ea-437a-bbb7-aa97e8f9beaa")
	)
	(text ""
		(exclude_from_sim no)
		(at 278.13 69.596 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "426e6e41-7146-4c03-ad96-b40ef95f8657")
	)
	(text "+"
		(exclude_from_sim no)
		(at 142.24 74.422 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "437110f5-4812-4891-9bb0-c36d128623c3")
	)
	(text "B+3 output = 0.6 × (1 + 169k/10k) = 10.74V nominal.\n⚠ SW NODE: high dV/dt at 1.2MHz. Keep SW trace <3mm.\nMinimum 2mm clearance to FG, ADC, and motor drive signal traces.\nC8 must be 47µF (not 22µF) - X5R derating at 10.8V reduces\neffective capacitance. Use 16V rated part for adequate margin."
		(exclude_from_sim no)
		(at 190.754 176.022 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4811ef51-7ec7-4f58-8dbf-afaa2904960f")
	)
	(text "B+1 output = 0.8 × (1 + 649k/100k) = 6.19V\nEN tied to VIN - AP63203 internal clamp handles 9V input safely.\nC3 (BST cap) must be placed within 1mm of BST/SW pins on PCB."
		(exclude_from_sim no)
		(at 194.564 47.752 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "4dcaae83-9626-4fb3-8da8-54831af869ad")
	)
	(text "Variant B input: 9V DC nominal, 5.5mm/2.1mm barrel jack.\nPolarity agnostic - bridge rectifier output is always positive.\nDo NOT connect a 6V adapter - minimum 7.5V required after\n0.8V bridge drop to maintain regulation headroom.\nSMBJ12A: standoff 12V, clamp 19.9V max. AP63203 VIN abs max 32V."
		(exclude_from_sim no)
		(at 54.356 197.104 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "51660755-5cd4-4509-9f1d-048725064c67")
	)
	(text "16v\n"
		(exclude_from_sim no)
		(at 183.896 83.312 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "6a7a79ea-8b70-4926-914a-f88db000485a")
	)
